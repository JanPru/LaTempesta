body { font-family: Calibri, sans-serif; font-size: 11pt; line-height: 1.5; margin: 2cm; }
h1 { font-size: 24pt; color: #2E74B5; border-bottom: 2px solid #2E74B5; padding-bottom: 8px; }
h2 { font-size: 16pt; color: #2E74B5; margin-top: 24px; }
